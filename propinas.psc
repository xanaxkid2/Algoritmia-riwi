Algoritmo propinas
	Definir cuenta Como Entero
	Definir porcentaje Como Entero
	Definir personas Como Entero
	Escribir "ingresa el valor de la cuenta"
	Leer cuenta
	Escribir "ingresa el porcentaje (solo el numero)"
	leer porcentaje
	Escribir "cuantos son"
	Leer personas
	propina = cuenta * porcentaje / 100
	total = cuenta + propina
	totalPersonas = total / personas
	Escribir "El valor de la propina es " , propina
	Escribir "el total de la cuenta es " , total
	Escribir " a cada persona le corresponde pagar " totalPersonas
	
FinAlgoritmo
